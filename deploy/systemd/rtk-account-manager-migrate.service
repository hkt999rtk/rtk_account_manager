[Unit]
Description=RTK Account Manager database migrations
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rtk-account-manager
Group=rtk-account-manager
EnvironmentFile=/etc/rtk-account-manager/account-manager.env
ExecStart=/opt/rtk-account-manager/bin/rtk-account-manager-migrate
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
WorkingDirectory=/opt/rtk-account-manager
