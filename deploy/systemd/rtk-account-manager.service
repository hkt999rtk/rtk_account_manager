[Unit]
Description=RTK Account Manager API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rtk-account-manager
Group=rtk-account-manager
EnvironmentFile=/etc/rtk-account-manager/account-manager.env
ExecStart=/opt/rtk-account-manager/bin/rtk-account-manager
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rtk-account-manager
WorkingDirectory=/opt/rtk-account-manager

[Install]
WantedBy=multi-user.target
