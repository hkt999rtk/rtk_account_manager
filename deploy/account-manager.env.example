# RTK Account Manager private-cloud environment template.
# Copy to /etc/rtk-account-manager/account-manager.env and replace placeholders
# from operator-owned secret storage. Do not commit real values.

DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
JWT_ACCESS_SECRET=<secret-from-secret-manager>
JWT_REFRESH_SECRET=<secret-from-secret-manager>

ACCOUNT_MANAGER_ENV=staging
ACCOUNT_MANAGER_VERSION=v0.1.0
ACCOUNT_MANAGER_LOG_LEVEL=info
ACCOUNT_MANAGER_LOG_DEVELOPMENT=false

# Staging on video-cloud-cd.local uses 18081 to avoid video_cloud API on 18080.
PORT=18081
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

AUTH_TOKEN_DELIVERY=log
AUTH_TOKEN_BASE_URL=
EMAIL_VERIFICATION_TTL=30m
PASSWORD_RESET_TTL=30m
OTP_RESEND_INTERVAL=60s
OTP_MAX_ATTEMPTS=5
SIGNUP_CAPTCHA_REQUIRED=false
SIGNUP_DISPOSABLE_DOMAINS=

# Configure SMTP_HOST and SMTP_FROM for SMTP auth-token delivery and quota
# approval/decline notifications.
# Leave blank only for evaluation/log-only deployments and record that as SKIP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Keycloak/OIDC SSO is disabled by default. When enabled, the client secret
# must come from operator-owned secret storage. Admin-managed providers should
# use client_secret_ref values such as env:OIDC_CLIENT_SECRET.
OIDC_ENABLED=false
OIDC_PROVIDER_ID=keycloak
OIDC_PROVIDER_NAME=Keycloak
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SCOPES=openid email profile
OIDC_AUTO_LINK_EMAIL=false

# Local/evaluation workers can use log. Production-like lifecycle deployments
# should use the approved broker adapter and operator-owned broker credentials.
CROSS_SERVICE_BROKER=log
ACCOUNT_VIDEO_COMMANDS_STREAM=account.video.commands
VIDEO_ACCOUNT_EVENTS_STREAM=video.account.events
CROSS_SERVICE_CONSUMER_GROUP=rtk_account_manager
CROSS_SERVICE_MAX_ATTEMPTS=5
CROSS_SERVICE_POLL_INTERVAL=5s
AZURE_EVENTHUB_CONNECTION_STRING=
AZURE_EVENTHUB_CHECKPOINT_FILE=/var/lib/rtk-account-manager/azure_eventhubs_checkpoint.json
