# RTK Account Manager private-cloud environment template.
# Copy to /etc/rtk-account-manager/account-manager.env and replace placeholders
# from operator-owned secret storage. Do not commit real values.

DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
JWT_ACCESS_SECRET=<secret-from-secret-manager>
JWT_REFRESH_SECRET=<secret-from-secret-manager>
FACTORY_PRODUCTION_JWT_SECRET=<factory-production-jwt-secret>
FACTORY_PRODUCTION_JWT_AUDIENCE=factory-enroll
# Dedicated service credential, at least 32 bytes. Empty disables factory coordination.
ACCOUNT_MANAGER_FACTORY_ENROLLMENT_TOKEN=

# New-cloud Billing outbox only; both values required to enable the worker.
# Same dedicated secret as Billing BILLING_CLOUD_CREATION_TOKEN, never a JWT,
# handoff/debit/factory/email credential. Remote URL must use HTTPS.
BILLING_CLOUD_CREATION_BASE_URL=
BILLING_CLOUD_CREATION_TOKEN=

# Ownership handoff is enabled only when Billing and this exact reviewed
# resource inventory are all configured. Every token is dedicated and distinct.
BILLING_HANDOFF_BASE_URL=
BILLING_HANDOFF_TOKEN=
FACTORY_HANDOFF_BASE_URL=
FACTORY_HANDOFF_TOKEN=
VIDEO_CONTROL_PLANE_HANDOFF_BASE_URL=
VIDEO_CONTROL_PLANE_HANDOFF_TOKEN=
MQTT_USAGE_HANDOFF_BASE_URL=
MQTT_USAGE_HANDOFF_TOKEN=
HANDOFF_WORKER_POLL_INTERVAL=5s
HANDOFF_WORKER_LEASE_DURATION=2m
HANDOFF_WORKER_STEP_TIMEOUT=45s
HANDOFF_WORKER_BATCH_SIZE=10

ACCOUNT_MANAGER_ENV=staging
ACCOUNT_MANAGER_VERSION=v0.1.0
ACCOUNT_MANAGER_LOG_LEVEL=info
ACCOUNT_MANAGER_LOG_DEVELOPMENT=false

# Staging on video-cloud-cd.local uses 18081 to avoid video_cloud API on 18080.
PORT=18081
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

AUTH_TOKEN_BASE_URL=
EMAIL_VERIFICATION_TTL=30m
PASSWORD_RESET_TTL=30m
OTP_RESEND_INTERVAL=60s
OTP_MAX_ATTEMPTS=5
SIGNUP_DISPOSABLE_DOMAINS=

# All account email is delivered through the Send Mail HTTPS API.
SENDMAIL_HTTP_BASE_URL=
SENDMAIL_HTTP_BEARER_TOKEN=
SENDMAIL_HTTP_TIMEOUT=15s
EMAIL_OUTBOX_ENCRYPTION_KEY=<base64-encoded-32-byte-secret>
EMAIL_OUTBOX_POLL_INTERVAL=5s
EMAIL_OUTBOX_BATCH_SIZE=20
EMAIL_OUTBOX_MAX_ATTEMPTS=8
EMAIL_OUTBOX_RETRY_BASE=30s
EMAIL_OUTBOX_RETRY_MAX=30m

# Keycloak/OIDC SSO is disabled by default. When enabled, the client secret
# must come from operator-owned secret storage. Admin-managed providers should
# use client_secret_ref values such as env:OIDC_CLIENT_SECRET.
OIDC_ENABLED=false
OIDC_PROVIDER_ID=keycloak
OIDC_PROVIDER_NAME=Keycloak
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SCOPES=openid email profile
OIDC_AUTO_LINK_EMAIL=false

# Local/evaluation workers can use log. Cloud lifecycle deployments use
# direct_http with the shared service token supplied by runtime secret storage.
CROSS_SERVICE_BROKER=log
ACCOUNT_VIDEO_COMMANDS_STREAM=account.video.commands
VIDEO_ACCOUNT_EVENTS_STREAM=video.account.events
CROSS_SERVICE_CONSUMER_GROUP=rtk_account_manager
CROSS_SERVICE_MAX_ATTEMPTS=5
CROSS_SERVICE_POLL_INTERVAL=5s
AZURE_EVENTHUB_CONNECTION_STRING=
AZURE_EVENTHUB_CHECKPOINT_FILE=/var/lib/rtk-account-manager/azure_eventhubs_checkpoint.json
VIDEO_CLOUD_LIFECYCLE_BASE_URL=
VIDEO_CLOUD_LIFECYCLE_TOKEN=
VIDEO_CLOUD_LIFECYCLE_TIMEOUT=10s
