DATABASE_URL=postgres://rtk:rtk_password@localhost:5432/rtk_account_manager?sslmode=disable
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Optional dedicated factory coordination credential; do not reuse JWT/internal tokens.
ACCOUNT_MANAGER_FACTORY_ENROLLMENT_TOKEN=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PORT=8080
AUTH_TOKEN_BASE_URL=http://localhost:3000
SENDMAIL_HTTP_BASE_URL=
SENDMAIL_HTTP_BEARER_TOKEN=
SENDMAIL_HTTP_TIMEOUT=15s
EMAIL_OUTBOX_ENCRYPTION_KEY=<base64-encoded-32-byte-secret>
EMAIL_OUTBOX_POLL_INTERVAL=5s
EMAIL_OUTBOX_BATCH_SIZE=20
EMAIL_OUTBOX_MAX_ATTEMPTS=8
EMAIL_OUTBOX_RETRY_BASE=30s
EMAIL_OUTBOX_RETRY_MAX=30m
CROSS_SERVICE_BROKER=log
AZURE_EVENTHUB_CONNECTION_STRING=
AZURE_EVENTHUB_CHECKPOINT_FILE=
ACCOUNT_VIDEO_COMMANDS_STREAM=account.video.commands
VIDEO_ACCOUNT_EVENTS_STREAM=video.account.events
CROSS_SERVICE_CONSUMER_GROUP=rtk_account_manager
CROSS_SERVICE_MAX_ATTEMPTS=5
CROSS_SERVICE_POLL_INTERVAL=5s
ACCOUNT_MANAGER_USER_CACHE_ENABLED=false
ACCOUNT_MANAGER_USER_CACHE_ADDR=127.0.0.1:6379
ACCOUNT_MANAGER_USER_CACHE_PREFIX=account_manager:user
ACCOUNT_MANAGER_BASE_URL=http://localhost:8080
ACCOUNT_MANAGER_VERSION=dev
READINESS_SMOKE_EMAIL=
READINESS_SMOKE_PASSWORD=
READINESS_SMOKE_ORG_ID=
READINESS_SMOKE_DEVICE_ID=
READINESS_MIGRATIONS_DIR=migrations
OIDC_ENABLED=false
OIDC_PROVIDER_ID=keycloak
OIDC_PROVIDER_NAME=Keycloak
OIDC_ISSUER_URL=http://localhost:8081/realms/rtk-local
OIDC_CLIENT_ID=rtk-account-manager
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/v1/auth/oidc/keycloak/callback
OIDC_SCOPES=openid email profile
OIDC_AUTO_LINK_EMAIL=false

# Dedicated internal Billing credential; never reuse login/internal/debit secrets.
# Recovery worker does not enable public deletion or install resource adapters.
BILLING_HANDOFF_BASE_URL=
BILLING_HANDOFF_TOKEN=
CLOUD_DELETION_WORKER_POLL_INTERVAL=5s
CLOUD_DELETION_WORKER_LEASE_DURATION=2m
CLOUD_DELETION_WORKER_STEP_TIMEOUT=45s
CLOUD_DELETION_WORKER_BATCH_SIZE=10
